rules_version = '2';

// firestore.rules
//
// Who can read and write what in the Firestore database.
// Every user's data lives under users/{uid}, and only that user can read it.
// The server (Cloud Functions using the Admin SDK) skips these rules entirely,
// which is how it writes transactions and import records that users can't.
//
// Tested by test/firestore.rules.test.js.

service cloud.firestore {
  match /databases/{database}/documents {

    // True if someone is logged in AND their user id matches the {uid} in the path
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The user's profile document (created at signup by src/lib/auth.js)
    match /users/{uid} {
      allow read: if isOwner(uid);
      // Create: only these 4 fields are allowed, so no one can sneak in extra data
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email','displayName','createdAt','consentAcceptedAt']);
      // Update: only the display name and the consent timestamp can change.
      // diff(...).affectedKeys() = the fields this write is changing.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName','consentAcceptedAt']);
      // No one can delete their profile from the app
      allow delete: if false;

      // Transactions are created only by Cloud Functions (Admin SDK bypasses rules).
      // Users may only re-categorize.
      match /transactions/{txnId} {
        allow read: if isOwner(uid);
        // Re-categorizing: only these 3 fields may change, the category must be text,
        // and categorySource must say 'user' so the app can tell AI vs user categories apart
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['category','categorySource','updatedAt'])
          && request.resource.data.category is string
          && request.resource.data.categorySource == 'user';
        // Users can't add or delete transactions (that would let them fake data)
        allow create, delete: if false;
      }

      // Budgets (SCRUM-81): a monthly limit per category, one doc per category with the
      // category id as the doc id. Unlike transactions, the user owns these and may
      // create, change and delete them, but only with this exact shape.
      match /budgets/{categoryId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['categoryId','limit','updatedAt'])
          && request.resource.data.categoryId == categoryId
          && request.resource.data.limit is number
          && request.resource.data.limit >= 0;
        allow delete: if isOwner(uid);
      }

      // Import status is written by the server; the client only reads it.
      match /imports/{importId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
    // Anything not matched above is denied by default.
  }
}