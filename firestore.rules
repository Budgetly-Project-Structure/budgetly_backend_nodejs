rules_version = '2';

// firestore.rules
//
// Who can read and write what in the Firestore database.
// Every user's data lives under users/{uid}, and only that user can read it.
// Transactions are moving to a top-level collection, owned by their userId field
// (SCRUM-113, block at the bottom).
// The server (Cloud Functions using the Admin SDK) skips these rules entirely,
// which is how it writes transactions and import records that users can't.
//
// Tested by test/firestore.rules.test.js.

service cloud.firestore {
  match /databases/{database}/documents {

    // True if someone is logged in AND their user id matches the {uid} in the path
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The exact shape of a manual transaction (SCRUM-86): a known set of fields,
    // owned by this user, marked source 'manual', with a real date, a merchant of
    // 1-100 characters, and a non-zero amount (negative = spending, positive = income).
    function isManualTxn(uid, d) {
      return d.keys().hasOnly(['userId','date','merchant','amount','category','categorySource',
                               'categoryConfidence','isUserCorrected','accountId',
                               'sourceStatementId','source','createdAt','updatedAt'])
        && isManualTxnShape(uid, d);
    }

    // The same checks without the list of allowed fields, so the top-level
    // transactions block (SCRUM-113) can also allow the soft-delete fields.
    function isManualTxnShape(uid, d) {
      return d.keys().hasAll(['userId','date','merchant','amount','category','source'])
        && d.userId == uid
        && d.source == 'manual'
        && d.date is timestamp
        && d.merchant is string && d.merchant.size() > 0 && d.merchant.size() <= 100
        && d.amount is number && d.amount != 0
        && d.category is string
        && d.categorySource == 'user';
    }

    // Profile and settings values that must make sense (SCRUM-88): a name of 1-60
    // characters, and a monthly income that is empty (null) or a dollar amount
    // from 0 to 10 million. Fields that aren't on the document aren't checked.
    function isValidProfile(d) {
      return (!('displayName' in d)
                || (d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 60))
        && (!('monthlyIncome' in d) || d.monthlyIncome == null
                || (d.monthlyIncome is number && d.monthlyIncome >= 0 && d.monthlyIncome <= 10000000));
    }

    // Soft delete and restore (data-framework.md). Instead of removing a document,
    // the app sets three fields; the server removes it for good after purgeAfter.
    // In the same write only these three (and updatedAt) may change.
    function onlyDeleteFieldsChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['deletedAt','deletedBy','purgeAfter','updatedAt']);
    }

    // True if the existing document isn't deleted (deletedAt missing or null)
    function isActive() {
      return resource.data.get('deletedAt', null) == null;
    }

    // Soft delete: an active doc gets deletedAt = now (serverTimestamp()),
    // deletedBy = the caller, and a purgeAfter later than now.
    function isSoftDelete() {
      return isActive()
        && onlyDeleteFieldsChange()
        && request.resource.data.deletedAt == request.time
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.purgeAfter is timestamp
        && request.resource.data.purgeAfter > request.time;
    }

    // Restore: a deleted doc has all three fields cleared back to null.
    function isRestore() {
      return !isActive()
        && onlyDeleteFieldsChange()
        && request.resource.data.deletedAt == null
        && request.resource.data.deletedBy == null
        && request.resource.data.purgeAfter == null;
    }

    // The user's profile document (created at signup by src/lib/auth.js). It also
    // holds their settings: monthlyIncome (SCRUM-84), used for the budget in a month
    // where no money came in.
    match /users/{uid} {
      allow read: if isOwner(uid);
      // Create: only these fields are allowed, so no one can sneak in extra data
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email','displayName','createdAt','consentAcceptedAt','monthlyIncome'])
        && isValidProfile(request.resource.data);
      // Update: only the display name, the consent timestamp and the monthly income
      // can change. diff(...).affectedKeys() = the fields this write is changing.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName','consentAcceptedAt','monthlyIncome'])
        && isValidProfile(request.resource.data);
      // No one can delete their profile from the app
      allow delete: if false;

      // OLD location. The app still reads and writes here until the move to the
      // top-level transactions collection (SCRUM-116/117). Remove this block after that.
      //
      // Imported transactions are created only by Cloud Functions (Admin SDK bypasses
      // rules), and for those the user may only re-categorize. Manual transactions
      // (SCRUM-86, source == 'manual') are the user's own: they can add, edit and
      // delete them, but only with the exact shape checked by isManualTxn.
      match /transactions/{txnId} {
        allow read: if isOwner(uid);
        // Re-categorizing: only these 3 fields may change, the category must be text,
        // and categorySource must say 'user' so the app can tell AI vs user categories apart
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['category','categorySource','updatedAt'])
          && request.resource.data.category is string
          && request.resource.data.categorySource == 'user';
        // Adding a manual transaction
        allow create: if isOwner(uid) && isManualTxn(uid, request.resource.data);
        // Editing a manual transaction (imported ones can't have their amount, date... changed)
        allow update: if isOwner(uid)
          && resource.data.get('source', '') == 'manual'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['date','merchant','amount','category','accountId','updatedAt'])
          && isManualTxn(uid, request.resource.data);
        // Only manual transactions can be deleted here. Imported ones are removed
        // together with their statement by the deleteImport Cloud Function.
        allow delete: if isOwner(uid) && resource.data.get('source', '') == 'manual';
      }

      // Budgets (SCRUM-81): a monthly limit per category, one doc per category with the
      // category id as the doc id. Unlike transactions, the user owns these and may
      // create and change them, but only with this exact shape.
      match /budgets/{categoryId} {
        allow read: if isOwner(uid);
        // Setting a limit. A soft-deleted budget must be restored first, so saving
        // a limit can't quietly undo a delete.
        allow create, update: if isOwner(uid)
          && (resource == null || isActive())
          && request.resource.data.keys().hasOnly(['categoryId','limit','updatedAt'])
          && request.resource.data.categoryId == categoryId
          && request.resource.data.limit is number
          && request.resource.data.limit >= 0;
        // Removing a budget is a soft delete (or a restore), never a real delete
        allow update: if isOwner(uid) && (isSoftDelete() || isRestore());
        allow delete: if false;
      }

      // Import status is written by the server; the client only reads it.
      match /imports/{importId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Transactions (SCRUM-113): one top-level collection for everyone. The owner is
    // the userId field, not the path, so every rule compares it with the uid from
    // the signed-in user's verified token (request.auth.uid). Schema:
    // budgetly_contracts/schemas/data-model.md.
    match /transactions/{transactionId} {
      // True if someone is logged in AND the existing doc's userId is them
      function isTxnOwner() {
        return request.auth != null && resource.data.userId == request.auth.uid;
      }

      // Read one doc or run a query. Rules aren't filters: a query must include
      // where("userId", "==", <own uid>) or Firestore rejects the whole query.
      allow read: if isTxnOwner();

      // Adding a manual transaction. Imported ones are written by Cloud Functions
      // (Admin SDK bypasses rules). userId must be the caller's own uid, and new
      // docs start out not deleted (deletedAt == null).
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['userId','date','merchant','amount','category','categorySource',
                                                  'categoryConfidence','isUserCorrected','accountId',
                                                  'sourceStatementId','source','createdAt','updatedAt',
                                                  'deletedAt','deletedBy','purgeAfter'])
        && isManualTxnShape(request.auth.uid, request.resource.data)
        && 'deletedAt' in request.resource.data
        && request.resource.data.deletedAt == null;

      // Changes by the owner. userId, source and sourceStatementId are never in
      // the allowed lists below, so they can't change.
      // Re-categorizing (any transaction): only the category fields
      allow update: if isTxnOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['category','categorySource','updatedAt'])
        && request.resource.data.category is string
        && request.resource.data.categorySource == 'user';
      // Editing a manual transaction (imported ones can't have their amount, date... changed)
      allow update: if isTxnOwner()
        && resource.data.get('source', '') == 'manual'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['date','merchant','amount','category','accountId','updatedAt'])
        && isManualTxnShape(request.auth.uid, request.resource.data);
      // Soft delete or restore, manual transactions only. Imported ones are
      // deleted together with their statement, by the server.
      allow update: if isTxnOwner()
        && resource.data.get('source', '') == 'manual'
        && (isSoftDelete() || isRestore());

      // Never deleted from the app. Deleting is a soft delete (above); the server
      // removes the doc for good after purgeAfter.
      allow delete: if false;
    }
    // Anything not matched above is denied by default.
  }
}