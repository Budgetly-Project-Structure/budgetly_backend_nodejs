rules_version = '2';

// firestore.rules
//
// Who can read and write what in the Firestore database.
// Every user's data lives under users/{uid}, and only that user can read it.
// The exception is transactions: one top-level collection, owned by their userId
// field (SCRUM-113, block at the bottom).
// The server (Cloud Functions using the Admin SDK) skips these rules entirely,
// which is how it writes transactions and import records that users can't.
//
// Tested by test/firestore.rules.test.js.

service cloud.firestore {
  match /databases/{database}/documents {

    // True if someone is logged in AND their user id matches the {uid} in the path
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The shape of a manual transaction (SCRUM-86): owned by this user, marked source
    // 'manual', with a real date, a merchant of 1-100 characters, and a non-zero
    // amountCents (whole cents; negative = spending, positive = income). The old dollar
    // `amount` is still accepted until the migration (SCRUM-151) and strict rules (SCRUM-152).
    // The list of allowed fields is checked where it's used (the transactions block at the bottom).
    function isManualTxnShape(uid, d) {
      return d.keys().hasAll(['userId','date','merchant','category','source'])
        && ('amountCents' in d || 'amount' in d)
        && (!('amountCents' in d) || (d.amountCents is int && d.amountCents != 0))
        && (!('amount' in d) || (d.amount is number && d.amount != 0))
        && d.userId == uid
        && d.source == 'manual'
        && d.date is timestamp
        && d.merchant is string && d.merchant.size() > 0 && d.merchant.size() <= 100
        && d.category is string
        && d.categorySource == 'user';
    }

    // Profile and settings values that must make sense (SCRUM-88): a name of 1-60
    // characters, and a monthly income that is empty (null) or a dollar amount
    // from 0 to 10 million. Fields that aren't on the document aren't checked.
    function isValidProfile(d) {
      return (!('displayName' in d)
                || (d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 60))
        && (!('monthlyIncome' in d) || d.monthlyIncome == null
                || (d.monthlyIncome is number && d.monthlyIncome >= 0 && d.monthlyIncome <= 10000000));
    }

    // Soft delete and restore (data-framework.md). Instead of removing a document,
    // the app sets three fields; the server removes it for good after purgeAfter.
    // In the same write only these three (and updatedAt) may change.
    function onlyDeleteFieldsChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['deletedAt','deletedBy','purgeAfter','updatedAt']);
    }

    // True if the existing document isn't deleted (deletedAt missing or null)
    function isActive() {
      return resource.data.get('deletedAt', null) == null;
    }

    // Soft delete: an active doc gets deletedAt = now (serverTimestamp()),
    // deletedBy = the caller, and a purgeAfter later than now.
    function isSoftDelete() {
      return isActive()
        && onlyDeleteFieldsChange()
        && request.resource.data.deletedAt == request.time
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.purgeAfter is timestamp
        && request.resource.data.purgeAfter > request.time;
    }

    // Restore: a deleted doc has all three fields cleared back to null.
    function isRestore() {
      return !isActive()
        && onlyDeleteFieldsChange()
        && request.resource.data.deletedAt == null
        && request.resource.data.deletedBy == null
        && request.resource.data.purgeAfter == null;
    }

    // The user's profile document (created at signup by src/lib/auth.js). It also
    // holds their settings: monthlyIncome (SCRUM-84), used for the budget in a month
    // where no money came in.
    match /users/{uid} {
      allow read: if isOwner(uid);
      // Create: only these fields are allowed, so no one can sneak in extra data
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email','displayName','createdAt','consentAcceptedAt','monthlyIncome'])
        && isValidProfile(request.resource.data);
      // Update: only the display name, the consent timestamp and the monthly income
      // can change. diff(...).affectedKeys() = the fields this write is changing.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName','consentAcceptedAt','monthlyIncome'])
        && isValidProfile(request.resource.data);
      // No one can delete their profile from the app
      allow delete: if false;

      // The old users/{uid}/transactions location is closed (SCRUM-116): transactions
      // now live in the top-level collection below, and anything not matched is denied.
      // scripts/migrateTransactions.js copies old documents across.

      // Budgets (SCRUM-81): a monthly limit per category, one doc per category with the
      // category id as the doc id. Unlike transactions, the user owns these and may
      // create and change them, but only with this exact shape.
      match /budgets/{categoryId} {
        allow read: if isOwner(uid);
        // Setting a limit. A soft-deleted budget must be restored first, so saving
        // a limit can't quietly undo a delete.
        // source (SCRUM-137) says who chose the limit: "auto" (Auto budget) or "user"
        // The limit is whole cents, limitCents (SCRUM-148): 25000 is $250. The old dollar
        // `limit` is still accepted, only until the web app has moved over and the existing
        // budgets are converted (SCRUM-151); SCRUM-152 then requires limitCents.
        allow create, update: if isOwner(uid)
          && (resource == null || isActive())
          && request.resource.data.keys().hasOnly(['categoryId','limit','limitCents','source','updatedAt'])
          // categoryId is the document id, so it is no longer saved (SCRUM-146). An older
          // document that still has it must match the id.
          && (!('categoryId' in request.resource.data) || request.resource.data.categoryId == categoryId)
          && ('limitCents' in request.resource.data || 'limit' in request.resource.data)
          && (!('limitCents' in request.resource.data)
              || (request.resource.data.limitCents is int && request.resource.data.limitCents >= 0))
          && (!('limit' in request.resource.data)
              || (request.resource.data.limit is number && request.resource.data.limit >= 0))
          && (!('source' in request.resource.data) || request.resource.data.source in ['auto', 'user']);
        // Removing a budget is a soft delete (or a restore), never a real delete
        allow update: if isOwner(uid) && (isSoftDelete() || isRestore());
        allow delete: if false;
      }

      // The budget sets itself once a month (SCRUM-137): one record per month,
      // with the month as the doc id, saying it happened and the savings kept.
      // It can only be created once (a second tab's create is refused), only the
      // savings can change later, and it's never deleted from the app.
      match /budgetMonths/{month} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['month','auto','savings','createdAt'])
          // month is the document id, so it is no longer saved (SCRUM-146). If it's
          // sent anyway it must match the id.
          && (!('month' in request.resource.data) || request.resource.data.month == month)
          && month.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.auto is bool
          && request.resource.data.savings is number
          && request.resource.data.savings >= 0;
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savings','updatedAt'])
          && request.resource.data.savings is number
          && request.resource.data.savings >= 0;
        allow delete: if false;
      }

      // Import status is written by the server; the client only reads it.
      match /imports/{importId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Transactions (SCRUM-113): one top-level collection for everyone. The owner is
    // the userId field, not the path, so every rule compares it with the uid from
    // the signed-in user's verified token (request.auth.uid). Schema:
    // budgetly_contracts/schemas/data-model.md.
    match /transactions/{transactionId} {
      // True if someone is logged in AND the existing doc's userId is them
      function isTxnOwner() {
        return request.auth != null && resource.data.userId == request.auth.uid;
      }

      // Read one doc or run a query. Rules aren't filters: a query must include
      // where("userId", "==", <own uid>) or Firestore rejects the whole query.
      allow read: if isTxnOwner();

      // isUserCorrected is no longer saved (SCRUM-146: categorySource == 'user' says the same
      // thing), but it stays in the allowed list so older clients and documents still work.
      // Adding a manual transaction. Imported ones are written by Cloud Functions
      // (Admin SDK bypasses rules). userId must be the caller's own uid, and new
      // docs start out not deleted (deletedAt == null).
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['userId','date','merchant','amount','amountCents','category','categorySource',
                                                  'categoryConfidence','isUserCorrected','accountId',
                                                  'sourceStatementId','source','createdAt','updatedAt',
                                                  'deletedAt','deletedBy','purgeAfter'])
        && isManualTxnShape(request.auth.uid, request.resource.data)
        && 'deletedAt' in request.resource.data
        && request.resource.data.deletedAt == null;

      // Changes by the owner. userId, source and sourceStatementId are never in
      // the allowed lists below, so they can't change.
      // Re-categorizing (any transaction): only the category fields
      allow update: if isTxnOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['category','categorySource','updatedAt'])
        && request.resource.data.category is string
        && request.resource.data.categorySource == 'user';
      // Editing a manual transaction (imported ones can't have their amount, date... changed)
      allow update: if isTxnOwner()
        && resource.data.get('source', '') == 'manual'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['date','merchant','amount','amountCents','category','accountId','updatedAt'])
        && isManualTxnShape(request.auth.uid, request.resource.data);
      // Soft delete or restore, manual transactions only. Imported ones are
      // deleted together with their statement, by the server.
      allow update: if isTxnOwner()
        && resource.data.get('source', '') == 'manual'
        && (isSoftDelete() || isRestore());

      // Never deleted from the app. Deleting is a soft delete (above); the server
      // removes the doc for good after purgeAfter.
      allow delete: if false;
    }

    // Accounts (SCRUM-167, budgetly_contracts schemas/data-model.md): the user's own bank accounts
    // and credit cards, one top-level document each with the owner in userId. Transactions and
    // statements keep only the account's id. Like transactions, a query must include
    // where("userId", "==", <own uid>).
    // New: the owner's own userId, a type of checking or credit, an institution of 1-60
    // characters, last4 empty or exactly 4 digits (never the full number), a nickname of
    // up to 40 characters, and deletedAt null.
    // Changing: only institution, last4 and nickname. userId and type never change.
    // Removing is a soft delete (and restore), never a real delete, the same as budgets.
    function isValidAccount(d) {
      return d.type in ['checking', 'credit']
        && d.institution is string && d.institution.size() > 0 && d.institution.size() <= 60
        && (!('last4' in d) || d.last4 == null || (d.last4 is string && d.last4.matches('^[0-9]{4}$')))
        && (!('nickname' in d) || d.nickname == null || (d.nickname is string && d.nickname.size() <= 40));
    }
    match /accounts/{accountId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['userId','type','institution','last4','nickname',
                                                  'createdAt','updatedAt','deletedAt','deletedBy','purgeAfter'])
        && request.resource.data.keys().hasAll(['userId','type','institution','deletedAt'])
        && request.resource.data.userId == request.auth.uid
        && isValidAccount(request.resource.data)
        && request.resource.data.deletedAt == null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
        && ((isActive()
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['institution','last4','nickname','updatedAt'])
             && isValidAccount(request.resource.data))
            || isSoftDelete() || isRestore());
      allow delete: if false;
    }

    // Audit log (SCRUM-120): one entry per delete, restore... written only by Cloud
    // Functions (Admin SDK). The owner can read their own entries; nobody can write,
    // change or remove them from the app. Like transactions, a query must include
    // where("userId", "==", <own uid>).
    match /auditLog/{entryId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Archive (Sprint 5 #11, budgetly_assets docs/data-framework.md): after 30 days, the
    // daily job moves soft-deleted data out of the app into these top-level collections.
    // Only the server and admin scripts (Admin SDK, which skips these rules) use them.
    // No user may read or write them, not even the owner of the data: archived documents
    // keep their userId, but the app never sees the archive. Written out explicitly
    // (instead of relying on the default deny) so the intent is clear and tested.
    //   archive_transactions/{transactionId}     a transaction, same ID
    //   archive_imports/{uid}_{importId}          an import record
    //   archive_budgets/{uid}_{categoryId}        a budget
    // Each keeps all its fields plus userId, originalPath, archivedAt
    // (and archivedFilePath for imports).
    match /archive_transactions/{docId} {
      allow read, write: if false;
    }
    match /archive_imports/{docId} {
      allow read, write: if false;
    }
    match /archive_budgets/{docId} {
      allow read, write: if false;
    }
    // archive_accounts/{uid}_{accountId}: an account (SCRUM-167), same rules
    match /archive_accounts/{docId} {
      allow read, write: if false;
    }
    // Anything not matched above is denied by default.
  }
}